<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="facetrace.controller.AdminController"
            stylesheets="@admin.css">
    <top>
        <HBox spacing="12" styleClass="header">
            <Label text="FaceTrace - Admin Records" styleClass="header-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="signedInLabel" styleClass="header-user" />
        </HBox>
    </top>
    <center>
        <VBox spacing="12" styleClass="page-content">
            <HBox spacing="14" styleClass="main-content" VBox.vgrow="ALWAYS">
                <VBox spacing="8" prefWidth="330" styleClass="content-section">
                    <Label text="Synthetic demo record" styleClass="section-title" />
                    <Label text="Case code (DEMO-###)" styleClass="field-label" />
                    <TextField fx:id="caseCodeField" promptText="For example: DEMO-041" />
                    <Label text="Subject name (Subject-###)" styleClass="field-label" />
                    <TextField fx:id="fullNameField" promptText="For example: Subject-041" />
                    <Label text="Synthetic age" styleClass="field-label" />
                    <TextField fx:id="ageField" promptText="Age in years" />
                    <Label text="Fictional case note" styleClass="field-label" />
                    <TextField fx:id="offenceTypeField" promptText="Short fictional note" />
                    <HBox spacing="8" styleClass="photo-row">
                        <Button fx:id="choosePhotoButton" text="Choose photo" onAction="#choosePhoto" />
                        <Label fx:id="photoPathLabel" text="No photo selected" wrapText="true" styleClass="photo-label" />
                    </HBox>
                    <CheckBox fx:id="syntheticConfirmCheckBox"
                              text="I confirm all details and the face photo are synthetic demo material."
                              wrapText="true" />
                    <HBox spacing="8">
                        <Button fx:id="addButton" text="Add" onAction="#addRecord" />
                        <Button fx:id="updateButton" text="Update selected" onAction="#updateRecord" disable="true" />
                        <Button fx:id="deleteButton" text="Delete selected" onAction="#deleteRecord" disable="true" />
                    </HBox>
                    <Button fx:id="clearButton" text="Clear form" onAction="#clearForm" styleClass="secondary-button" />
                </VBox>
                <VBox spacing="8" styleClass="content-section" HBox.hgrow="ALWAYS">
                    <HBox spacing="10">
                        <Label text="Saved records" styleClass="section-title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="refreshButton" text="Refresh" onAction="#refreshRecords" styleClass="secondary-button" />
                    </HBox>
                    <TableView fx:id="recordsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="caseColumn" text="Case code" prefWidth="125" sortable="false" />
                            <TableColumn fx:id="nameColumn" text="Subject" prefWidth="130" sortable="false" />
                            <TableColumn fx:id="ageColumn" text="Age" prefWidth="55" sortable="false" />
                            <TableColumn fx:id="noteColumn" text="Fictional note" prefWidth="180" sortable="false" />
                            <TableColumn fx:id="photoColumn" text="Photo file" prefWidth="125" sortable="false" />
                        </columns>
                    </TableView>
                    <Label fx:id="statusLabel" text="Admin record actions are saved to audit_log."
                           wrapText="true" styleClass="status" />
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
